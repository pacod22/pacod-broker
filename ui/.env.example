# The console's settings (src/env.ts says what each is). With none set it docks to a broker
# whose admin API is on 127.0.0.1:18061, in open mode.
BROKER_CONSOLE_BROKERS=default=http://127.0.0.1:18061
BROKER_UI_AUTH=open
# BROKER_UI_ADMIN_TOKEN=
# BROKER_ID_ISSUER=https://id.example.com
# BROKER_ID_INTERNAL_URL=http://pacod-id-internal:8071
# BROKER_UI_CLIENT_ID=pacod-broker-ui
# BROKER_UI_CLIENT_SECRET=
# BROKER_UI_SESSION_SECRET=
# BROKER_CONSOLE_URL=https://broker.example.com
# PROMETHEUS_URL=http://pacod-prometheus:9090
# GRAFANA_URL=https://grafana.example.com
