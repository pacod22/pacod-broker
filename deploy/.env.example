# pacod-broker: every variable, with its default. Nothing here is required: with no variable set
# the broker runs in open mode on port 8060 and keeps nothing (docs/runbook.md §2).
# Copy to deploy/.env and uncomment what you change. A BROKER_ variable the broker does not know
# stops it from starting, so a misspelt name is noticed.

# --- Identity and listeners ---------------------------------------------------------------
# This broker's id: the origin of every record announced on it.
# BROKER_ID=broker
# The public listener: discovery, registration, reports, MCP.
# BROKER_LISTEN=0.0.0.0:8060
# The management API the console calls. Off unless set; in the full stack an alias on the
# internal network pacod-admin-net.
# BROKER_ADMIN_LISTEN=pacod-broker-admin:8061
# Prometheus metrics; `off` turns them off.
# BROKER_METRICS_LISTEN=0.0.0.0:9160

# --- Access -------------------------------------------------------------------------------
# open: anyone may announce and discover (development, closed networks). oidc: pacod-id.
# BROKER_AUTH=open
# With BROKER_AUTH=open, a bearer token the admin API requires (at least 24 characters).
# BROKER_ADMIN_TOKEN=
# BROKER_ADMIN_TOKEN_FILE=
# Anonymous callers may discover resources whose visibility is `public`.
# BROKER_PUBLIC_DISCOVERY=false
# off, or new_providers: a provider's first announcement waits for an admin's approval.
# BROKER_APPROVAL=off

# --- pacod-id (BROKER_AUTH=oidc) ----------------------------------------------------------
# The issuer, or several separated by commas.
# BROKER_ID_ISSUER=https://id.example.com
# BROKER_ID_INTERNAL_URL=http://pacod-id-internal:8071
# BROKER_ID_CLIENT_ID=pacod-broker-service
# BROKER_ID_CLIENT_SECRET=
# BROKER_ID_CLIENT_SECRET_FILE=
# BROKER_ID_AUDIENCE=pacod-broker

# --- What is kept -------------------------------------------------------------------------
# A directory for static entries added through the admin API, reputation evidence and the
# ticket key. Without it they live in memory only.
# BROKER_STATE_DIR=/var/lib/pacod-broker
# A YAML file of static providers and resources, read at start and on SIGHUP.
# BROKER_CATALOG_FILE=

# --- Leases and limits --------------------------------------------------------------------
# BROKER_LEASE_TTL_DEFAULT=30
# BROKER_LEASE_TTL_MIN=5
# BROKER_LEASE_TTL_MAX=3600
# BROKER_MAX_RESOURCES=100000
# BROKER_MAX_RESOURCES_PER_PROVIDER=5000
# BROKER_MAX_LEASES_PER_PROVIDER=16
# BROKER_MAX_BODY_BYTES=8388608
# BROKER_MAX_DESCRIPTION_BYTES=16384
# How long changes are gathered before the index is rebuilt, in milliseconds.
# BROKER_REBUILD_MS=20

# --- Reputation (docs/reputation.md) ------------------------------------------------------
# The key interaction tickets are signed with (at least 32 characters). Without it the broker
# keeps one in BROKER_STATE_DIR, or makes a new one at every start.
# BROKER_TICKET_KEY=
# BROKER_TICKET_KEY_FILE=
# BROKER_TICKET_TTL=86400
# BROKER_REPUTATION_EVERY=60
# BROKER_REPUTATION_HALF_LIFE_DAYS=30
# BROKER_REPUTATION_PRIOR_WEIGHT=10
# component=weight pairs; the ones not named keep their defaults.
# BROKER_REPUTATION_WEIGHTS_PROVIDER=availability=0.2,reliability=0.2,performance=0.15,accuracy=0.15,lease_discipline=0.05,stability=0.05,quality=0.15,trust=0.05
# BROKER_REPUTATION_WEIGHTS_CLIENT=identity=0.25,conduct=0.3,settlement=0.2,commitment=0.1,feedback_honesty=0.1,tenure=0.05
# Maintenance announced at least this many seconds ahead does not count as an outage.
# BROKER_MAINTENANCE_NOTICE=86400

# --- Logging (pacod-demo/docs/LOGGING.md) -------------------------------------------------
# BROKER_LOG_FORMAT=json
# RUST_LOG=info
# SERVICE_NAME=pacod-broker
# An env file to read; variables of the process win over it.
# BROKER_ENV_FILE=
